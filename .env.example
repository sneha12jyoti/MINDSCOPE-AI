# MINDSCOPE AI Configuration

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# API Configuration
PROJECT_NAME="MINDSCOPE AI"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL in production; SQLite fallback for tests/local dev)
DATABASE_URL="postgresql://mindscope_user:replace_with_a_unique_local_password@localhost:5432/mindscope_db"
# Test/local SQLite alternative: sqlite:///./mindscope_dev.db
POSTGRES_USER=mindscope_user
POSTGRES_PASSWORD=replace_with_a_unique_local_password
POSTGRES_DB=mindscope_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Machine Learning & Artifacts
MODEL_PATH="ml_engine/artifacts/mindscope_pipeline.joblib"
LEGACY_MODEL_PATH="Mental_Health_Model.pkl"
MLFLOW_TRACKING_URI="file:./mlruns"

# Security & Limits
RATE_LIMIT_PER_MINUTE=60
